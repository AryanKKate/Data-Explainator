# Data Explainator Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Configuration (REQUIRED)
# =============================================================================

# Groq API Key - Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model name to use
MODEL_NAME=mixtral-8x7b-32768

# Temperature for LLM responses (0.0 = deterministic, 1.0 = random)
LLM_TEMPERATURE=0.2


# =============================================================================
# Application Configuration
# =============================================================================

# Enable debug mode (verbose logging)
DEBUG=False

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable test mode (uses mock data if available)
TEST_MODE=False


# =============================================================================
# Constraints & Limits
# =============================================================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=100


# =============================================================================
# Database Configuration (Optional)
# =============================================================================

# Database URL (if using database backend)
# DATABASE_URL=postgresql://user:password@localhost/database


# =============================================================================
# API Configuration (Optional)
# =============================================================================

# API host and port
# API_HOST=0.0.0.0
# API_PORT=8000


# =============================================================================
# Logging Configuration (Optional)
# =============================================================================

# Log file path (leave empty to disable file logging)
# LOG_FILE=logs/app.log


# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# Enable AutoML features
# ENABLE_AUTOML=False

# Enable real-time monitoring
# ENABLE_MONITORING=False

# Enable explanability (SHAP)
# ENABLE_EXPLAINABILITY=False
